# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub — it's already in .gitignore.

# A long random string used to sign login session cookies.
# Generate one by running this on your computer:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# The exact web address of your live dashboard (Netlify URL).
# This is the ONLY website allowed to make logged-in requests to this backend.
ALLOWED_ORIGIN=http://localhost:8888

# Set to "production" when running on Render. Leave unset for local testing.
NODE_ENV=

# Optional — only needed if bank.json isn't in the default location
# (a "data" folder right next to server.js, at the repo root).
BANK_JSON_PATH=
